# Application Configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="FeedbackIQ"
API_V1_STR="/api/v1"

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=feedbackiq_user
POSTGRES_PASSWORD=feedbackiq_secret_pass
POSTGRES_DB=feedbackiq
DATABASE_URL=postgresql+asyncpg://feedbackiq_user:feedbackiq_secret_pass@localhost:5433/feedbackiq

# Security & Authentication
SECRET_KEY=feedbackiq-dev-jwt-secret-key-super-secure-change-in-prod-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# AI / LLM Integration (Configurable provider: mock, gemini, groq, openai)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
