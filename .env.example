# FeedbackIQ Configuration Example
APP_NAME=FeedbackIQ
APP_ENV=development
DEBUG=true
SECRET_KEY=change_this_to_a_long_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Public Application URL
PUBLIC_URL=http://localhost:8000

# Database Connections (PostgreSQL 16/18 with psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/feedbackiq
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/feedbackiq_test

# AI Model Configuration (Groq primary, Ollama fallback, Keyword rules last resort)
# NEVER include OpenAI or GPT models!
LLM_CHAIN=groq:qwen/qwen3.8-27b,groq:llama-3.3-70b-versatile,ollama:gemma3:4b,ollama:llama3:8b,ollama:qwen2.5:1.5b,rules
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=15

# Security & Rate Limiting
CSRF_SECRET_KEY=change_this_to_a_random_csrf_key_in_production
RATE_LIMIT_PUBLIC_PER_MINUTE=15
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
